<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <RadioGroup
        android:id="@+id/connectModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/connectModeReaderWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/connect_option_reader_wifi" />

        <RadioButton
            android:id="@+id/connectModeSameNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_option_same_network" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/connectRememberChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/connect_option_remember" />

</LinearLayout>
